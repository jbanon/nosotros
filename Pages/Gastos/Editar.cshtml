@page "{id:int?}"
@model Love.Pages.Gastos.EditarModel
@{
    var g = Model.Gasto;
    ViewData["Title"] = Model.Nuevo ? (Model.Lunes != null ? "Apuntar la compra" : "Nuevo gasto") : $"{g.Tipo} del {g.Fecha:d 'de' MMMM}";
}
<div class="cab">
    <a class="volver" href="@(Model.Lunes != null ? $"/Menu/Lista?lunes={Model.Lunes:yyyy-MM-dd}" : $"/Gastos?anio={g.Fecha.Year}&mes={g.Fecha.Month}")">‹</a>
    <h1>@ViewData["Title"]</h1>
</div>
@if (!Model.Nuevo)
{
    <div class="aviso mb fila" style="align-items:center">
        <span class="crece">Estás <b>editando</b> un gasto ya apuntado (@g.Importe.ToString("N2") €). Si cambias el importe, sustituye al anterior.</span>
        <a class="btn pequeno" href="/Gastos/Editar?fecha=@Reloj.Hoy.ToString("yyyy-MM-dd")">+ Otra compra</a>
    </div>
}
else if (Model.Lunes != null)
{
    <p class="suave peq" style="margin-top:0">Pon el importe del ticket y, si quieres, hazle una foto. El detalle lleva ya lo que has marcado como comprado.</p>
}
<form method="post" enctype="multipart/form-data" id="fg">
    <input type="hidden" asp-for="Gasto.Id" />
    <input type="hidden" asp-for="Lunes" />
    <span class="etiqueta">Tipo</span>
    <div class="chips mb">
        <label class="chip veva"><input type="radio" asp-for="Gasto.Tipo" value="Veva" data-importe="@Model.ImporteVeva.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" /> Veva</label>
        <label class="chip"><input type="radio" asp-for="Gasto.Tipo" value="Compra" data-importe="" /> Compra</label>
        <label class="chip hipoteca"><input type="radio" asp-for="Gasto.Tipo" value="Hipoteca" data-importe="@Model.ImporteHipoteca.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" /> Hipoteca</label>
    </div>
    <label class="campo"><span>Importe (€)</span><input asp-for="ImporteTexto" inputmode="decimal" placeholder="0,00" autocomplete="off" style="font-size:1.6rem;font-weight:800" /></label>
    @if (Model.Error != null) { <p class="error">@Model.Error</p> }
    <label class="campo"><span>Fecha</span><input asp-for="Gasto.Fecha" type="date" /></label>
    <label class="campo"><span>Nota (opcional)</span><input asp-for="Gasto.Nota" placeholder="Mercadona, frutería…" /></label>
    <details class="ticket" id="ticket" @(Model.LinProducto.Any(x => !string.IsNullOrWhiteSpace(x)) ? "open" : "")>
        <summary>Detalle del ticket <span class="suave peq" style="font-weight:600">· opcional, para detectar compras recurrentes</span></summary>
        <div id="lineas">
            @for (int i = 0; i < Model.LinProducto.Count; i++)
            {
                <div class="linea-ticket">
                    <input type="text" name="LinProducto" list="productos" value="@Model.LinProducto[i]" placeholder="Producto" class="crece" autocomplete="off" />
                    <input type="text" name="LinImporte" value="@(i < Model.LinImporte.Count ? Model.LinImporte[i] : "")" inputmode="decimal" placeholder="€" style="width:84px" />
                    <button type="button" class="quitar" aria-label="Quitar línea">×</button>
                </div>
            }
        </div>
        <button type="button" class="btn pequeno mt" id="mas-linea">+ línea</button>
        <datalist id="productos">@foreach (var pr in Model.ProductosConocidos) { <option value="@pr"></option> }</datalist>
    </details>
    <label class="campo"><span>Foto del ticket o fichero</span><input type="file" asp-for="Adjunto" accept="image/*,application/pdf" capture="environment" /></label>
    @if (g.AdjuntoPath != null)
    {
        <div class="tarjeta fila">
            @if (g.AdjuntoMime?.StartsWith("image/") == true) { <a href="/Gastos/Adjunto/@g.Id" target="_blank"><img class="miniatura" src="/Gastos/Adjunto/@g.Id" alt="" style="width:80px;height:80px" /></a> }
            else { <a href="/Gastos/Adjunto/@g.Id" target="_blank">📎 @g.AdjuntoNombre</a> }
            <label class="chip" style="margin-left:auto"><input type="checkbox" asp-for="QuitarAdjunto" style="display:inline" /> Quitar</label>
        </div>
    }
    <button class="btn primario ancho">Guardar</button>
</form>
@if (!Model.Nuevo && (!g.EsFijo || User.EsAdmin()))
{
    <form method="post" asp-page-handler="Borrar" asp-route-id="@g.Id" data-confirm="¿Borrar este gasto?" class="mt"><button class="btn peligro ancho">Borrar</button></form>
}
@section Scripts {
<script>
document.querySelectorAll('input[name="Gasto.Tipo"]').forEach(r => r.addEventListener('change', () => {
  const imp = document.getElementById('ImporteTexto');
  if (r.dataset.importe) imp.value = r.dataset.importe; else { imp.value = ''; imp.focus(); }
}));
@if (Model.Nuevo) { <text>document.getElementById('ImporteTexto').focus();</text> }
// Líneas del ticket
const lineas = document.getElementById('lineas'), ticket = document.getElementById('ticket');
function nuevaLinea(foco) {
  const d = document.createElement('div'); d.className = 'linea-ticket';
  d.innerHTML = '<input type="text" name="LinProducto" list="productos" placeholder="Producto" class="crece" autocomplete="off" />'
              + '<input type="text" name="LinImporte" inputmode="decimal" placeholder="€" style="width:84px" />'
              + '<button type="button" class="quitar" aria-label="Quitar línea">×</button>';
  lineas.appendChild(d); if (foco) d.querySelector('input').focus();
}
lineas.addEventListener('click', e => { if (e.target.classList.contains('quitar')) { e.target.parentElement.remove(); if (!lineas.children.length) nuevaLinea(false); } });
lineas.addEventListener('input', e => { const ult = lineas.lastElementChild; if (ult && ult.contains(e.target) && ult.querySelector('input').value.trim()) nuevaLinea(false); });
document.getElementById('mas-linea').addEventListener('click', () => nuevaLinea(true));
if (!lineas.children.length) nuevaLinea(false);
function tipoCompra() { const t = document.querySelector('input[name="Gasto.Tipo"]:checked'); ticket.style.display = (!t || t.value === 'Compra') ? '' : 'none'; }
document.querySelectorAll('input[name="Gasto.Tipo"]').forEach(r => r.addEventListener('change', tipoCompra)); tipoCompra();
</script>
}

@page
@model Love.Pages.Gastos.IndexModel
@{
    ViewData["Title"] = "Gastos";
    var pct = Model.Objetivo > 0 ? (double)(Model.Compra / Model.Objetivo) * 100 : 0;
    var clase = pct > 100 ? "mal" : pct >= 70 ? "aviso" : "";
    var resto = Model.Objetivo - Model.Compra;
    var ant = Model.Inicio.AddMonths(-1); var sig = Model.Inicio.AddMonths(1);
    string tipo(TipoGasto t) => t.ToString().ToLowerInvariant();
}
<div class="cab"><h1>Gastos</h1><a class="accion" href="/Gastos/Historico">Histórico 📊</a></div>
<div class="segmento">
    <a href="?anio=@ant.Year&mes=@ant.Month">‹</a>
    <div class="titulo">@Model.Inicio.ToString("MMMM yyyy")</div>
    <a href="?anio=@sig.Year&mes=@sig.Month">›</a>
</div>

<div class="tarjeta">
    <div class="fila"><span class="etiqueta crece" style="margin:0">Compra del mes</span><span class="suave peq">objetivo @Model.Objetivo.ToString("N0") €</span></div>
    <div class="grande">@Model.Compra.ToString("N2") €</div>
    <div class="progreso @clase"><i style="width:@(Math.Min(100, pct).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
    <div class="peq" style="font-weight:700;color:@(resto < 0 ? "var(--mal)" : "var(--ok)")">
        @(resto >= 0 ? $"Te quedan {resto:N2} €" : $"Te has pasado {(-resto):N2} €")
    </div>
</div>

<div class="tarjeta">
    <div class="totales">
        <div><span class="peq suave">Veva</span><b>@Model.Veva.ToString("N0") €</b></div>
        <div><span class="peq suave">Hipoteca</span><b>@Model.Hipoteca.ToString("N0") €</b></div>
        <div><span class="peq suave">Total mes</span><b>@Model.Total.ToString("N0") €</b></div>
    </div>
</div>

@if (!Model.Lista.Any()) { <div class="vacio"><span class="ico">🧾</span>Sin movimientos este mes.</div> }
@foreach (var dia in Model.Lista.GroupBy(g => g.Fecha))
{
    <div class="dia-cab">@dia.Key.ToString("dddd d")</div>
    <div class="lista">
        @foreach (var g in dia)
        {
            <a class="item" href="/Gastos/Editar/@g.Id">
                <span class="punto @tipo(g.Tipo)"></span>
                @if (g.AdjuntoMime?.StartsWith("image/") == true) { <img class="miniatura" src="/Gastos/Adjunto/@g.Id" alt="" loading="lazy" /> }
                <div class="crece">
                    <div class="nombre">@g.Tipo @if (g.EsFijo) { <span class="suave peq">· fijo</span> }</div>
                    @if (!string.IsNullOrWhiteSpace(g.Nota) || (g.AdjuntoPath != null && g.AdjuntoMime?.StartsWith("image/") != true))
                    { <div class="sub">@g.Nota @if (g.AdjuntoPath != null && g.AdjuntoMime?.StartsWith("image/") != true) { <span>📎 @g.AdjuntoNombre</span> }</div> }
                </div>
                <div class="der">@g.Importe.ToString("N2") €</div>
            </a>
        }
    </div>
}
<a class="fab" href="/Gastos/Editar?fecha=@(Model.Inicio.Month == Reloj.Hoy.Month && Model.Inicio.Year == Reloj.Hoy.Year ? Reloj.Hoy : Model.Inicio)" aria-label="Nuevo gasto">+</a>

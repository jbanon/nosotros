@page
@model Love.Pages.Vinetas.IndexModel
@{ ViewData["Title"] = "Álbum"; var favoritas = Model.Dias.Count(d => d.Vineta.Favorita); }
<div class="cab"><a class="volver" href="/Amor">‹</a><h1>Álbum 💌</h1>@if (Model.Corazones > 0) { <span class="pill ok">♥ @Model.Corazones</span> }</div>
<div class="ideas-intro">Las viñetas que te voy dejando, con lo que quería decirte con cada una. Algunas llegan como juego: resuélvelo y pasan al álbum.</div>
@if (Model.Pendientes.Any())
{
    <h2 class="mb">Por jugar <span class="suave peq" style="font-weight:600">· los juegos no caducan</span></h2>
    <div class="lista mb">
        @foreach (var p in Model.Pendientes)
        {
            var esHoy = p.Fecha == Reloj.Hoy;
            <a class="item" href="/Vinetas/Hoy?fecha=@p.Fecha.ToString("yyyy-MM-dd")">
                <span style="font-size:1.6rem">🧩</span>
                <div class="crece"><b>@(esHoy ? "Hoy" : p.Fecha.ToString("dddd d 'de' MMMM"))</b><div class="sub">@Love.Pages.Amor.IndexModel.NombreJuego(p.Juego)@(p.AbiertaEl != null && p.Estado != null ? " · empezado" : "")</div></div>
                <span class="suave">›</span>
            </a>
        }
    </div>
}
@{ var siguiente = Model.Logros.FirstOrDefault(l => !l.Conseguido); }
<details class="ticket logros">
    <summary>♥ @Model.Corazones corazón@(Model.Corazones == 1 ? "" : "es") @if (siguiente != null) { <span class="suave peq" style="font-weight:600">· a @(siguiente.Corazones - Model.Corazones) de @siguiente.Emoji @siguiente.Nombre.ToLowerInvariant()</span> } else { <span class="suave peq" style="font-weight:600">· todo desbloqueado</span> }</summary>
    <p class="suave peq" style="margin:8px 0 10px">Cada juego resuelto suma un corazón. Con ellos se abren cosas:</p>
    @foreach (var l in Model.Logros)
    {
        <div class="logro @(l.Conseguido ? "si" : "")">
            <span class="emoji">@l.Emoji</span>
            <div class="crece"><b>@l.Nombre</b> <span class="suave peq">· @l.Corazones ♥</span>
                @if (l.Conseguido && l.Clave == "grande") { <div class="sub">@l.Texto Entra en cualquier viñeta del álbum y pulsa "Rompecabezas grande".</div> }
                else if (l.Conseguido && l.Clave == "vale") { <div class="sub vale-texto">@l.Texto</div>
                    @if (!Model.ValeCanjeado) { <form method="post" asp-page-handler="Canjear" data-confirm="¿Canjear el vale ahora? Le llegará el aviso a @Model.Firma."><button class="btn pequeno primario mt">Canjear</button></form> } else { <div class="sub" style="color:var(--ok-texto);font-weight:700">Canjeado ✓</div> } }
                else if (l.Conseguido && l.Clave == "carta") { <div class="sub carta-texto" style="white-space:pre-line">@(string.IsNullOrWhiteSpace(l.Texto) ? "(Javi aún no la ha escrito…)" : l.Texto)</div> }
                else { <div class="sub suave">Se abre con @l.Corazones corazones.</div> }
            </div>
            <span class="estado">@(l.Conseguido ? "✓" : "🔒")</span>
        </div>
    }
</details>
<p class="suave peq">@Model.Dias.Count descubierta@(Model.Dias.Count == 1 ? "" : "s")@(Model.Total > Model.Dias.Count ? $" · quedan {Model.Total - Model.Dias.Count} por descubrir" : "")@(favoritas > 0 ? $" · {favoritas} favorita{(favoritas == 1 ? "" : "s")}" : "")</p>
@if (!Model.Dias.Any())
{
    <div class="vacio"><span class="ico">💌</span>Todavía no hay viñetas. La primera llegará un día de estos a tu página.</div>
}
<div class="album">
    @foreach (var d in Model.Dias)
    {
        <a class="album-item" href="/Vinetas/Ver/@d.VinetaId">
            <img src="/Vinetas/Imagen/@d.VinetaId" alt="" loading="lazy" />
            @if (d.Vineta.Favorita) { <span class="fav">♥</span> }
            @if (d.Juego != JuegoVineta.Ninguno) { <span class="juego">🧩</span> }
            <div class="pie"><span class="fecha">@d.Fecha.ToString("d MMM")</span>@if (!string.IsNullOrWhiteSpace(d.Vineta.FraseMia)) { <span class="frase">@d.Vineta.FraseMia</span> }</div>
        </a>
    }
</div>

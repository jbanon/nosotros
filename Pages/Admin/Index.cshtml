@page
@model Love.Pages.Admin.IndexModel
@{ ViewData["Title"] = "Admin"; }
<div class="cab"><h1>Admin</h1><a class="accion" href="/Login?salir=true">Salir</a></div>
<div class="lista menu-admin">
    <a class="tarjeta enlace" href="/Admin/Mensajes"><span class="ico">💌</span><div class="crece"><b>Frases y poemas</b><div class="sub suave">@Model.NumMensajes mensajes, uno por día</div></div><span class="suave">›</span></a>
    <a class="tarjeta enlace" href="/Admin/Fechas"><span class="ico">📅</span><div class="crece"><b>Fechas especiales</b><div class="sub suave">@Model.NumFechas fechas con mensaje propio</div></div><span class="suave">›</span></a>
    <a class="tarjeta enlace" href="/Ideas"><span class="ico">✨</span><div class="crece"><b>Ideas para automatizar</b><div class="sub suave">Lo que Raquel quiere que se haga solo</div></div><span class="suave">›</span></a>
    <a class="tarjeta enlace" href="/Admin/Lecturas"><span class="ico">📖</span><div class="crece"><b>Lecturas para Raquel</b><div class="sub suave">Artículos, cuentos, poemas… con lector cómodo</div></div><span class="suave">›</span></a>
    <a class="tarjeta enlace" href="/Admin/Vinetas"><span class="ico">🖼️</span><div class="crece"><b>Viñetas</b><div class="sub suave">La colección, tu frase en cada una, reparto y respuestas de Raquel</div></div><span class="suave">›</span></a>
    <a class="tarjeta enlace" href="/Admin/Adviento"><span class="ico">🎄</span><div class="crece"><b>Calendario de adviento</b><div class="sub suave">24 casillas: fotos, criptofrases, murdokus, crucigramas y vales</div></div><span class="suave">›</span></a>
    <a class="tarjeta enlace" href="/Peliculas"><span class="ico">🎬</span><div class="crece"><b>Películas que ver</b><div class="sub suave">Pendientes y vistas</div></div><span class="suave">›</span></a>
    <a class="tarjeta enlace" href="/Amor?fecha=@Reloj.Hoy.ToString("yyyy-MM-dd")"><span class="ico">👀</span><div class="crece"><b>Ver la página de Raquel</b><div class="sub suave">Cómo la ve hoy</div></div><span class="suave">›</span></a>
    <a class="tarjeta enlace" href="/Admin/Config"><span class="ico">⚙️</span><div class="crece"><b>Configuración</b><div class="sub suave">Objetivo, fijos, PINs, copia de seguridad</div></div><span class="suave">›</span></a>
</div>
<div class="tarjeta mt">
    <h2 class="mb">Previsualizar otro día</h2>
    <form method="get" action="/Amor" class="fila">
        <input type="date" name="fecha" value="@Reloj.Hoy.ToString("yyyy-MM-dd")" class="crece" />
        <button class="btn">Ver</button>
    </form>
</div>

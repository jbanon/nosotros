@page
@model Love.Pages.Admin.ConfigModel
@{ ViewData["Title"] = "Configuración"; }
<div class="cab"><a class="volver" href="/Admin">‹</a><h1>Configuración</h1></div>
@if (Model.Mensaje != null) { <div class="aviso mb">@Model.Mensaje</div> }
<form method="post" class="tarjeta">
    <h2 class="mb">Gastos</h2>
    <label class="campo"><span>Objetivo de compra al mes (€)</span><input asp-for="Objetivo" inputmode="decimal" /></label>
    <div class="cuadricula">
        <label class="campo"><span>Veva fijo (€)</span><input asp-for="Veva" inputmode="decimal" /></label>
        <label class="campo"><span>Hipoteca fija (€)</span><input asp-for="Hipoteca" inputmode="decimal" /></label>
    </div>
    <h2 class="mb">Lista de la compra</h2>
    <label class="campo"><span>Raciones para las que se calcula la lista</span><input asp-for="RacionesLista" type="number" inputmode="numeric" min="1" max="50" /></label>
    <p class="suave peq" style="margin-top:-6px">Cada receta guarda sus cantidades para sus raciones; la lista las escala a este número.</p>
    <h2 class="mb">Página de amor</h2>
    <div class="cuadricula">
        <label class="campo"><span>Firma</span><input asp-for="Firma" /></label>
        <label class="campo"><span>Su nombre</span><input asp-for="NombreElla" /></label>
    </div>
    <label class="campo"><span>Declaración permanente (una línea por verso; vacío para ocultarla)</span><textarea asp-for="Declaracion" rows="6"></textarea></label>
    <button class="btn primario ancho">Guardar</button>
</form>
<form method="post" asp-page-handler="Pin" class="tarjeta">
    <h2 class="mb">Cambiar PIN</h2>
    <label class="campo"><span>Usuario</span><select name="rol"><option value="Raquel">Raquel</option><option value="Admin">Javi</option></select></label>
    <div class="cuadricula">
        <label class="campo"><span>Nuevo PIN</span><input type="password" name="pin1" inputmode="numeric" minlength="4" maxlength="6" required /></label>
        <label class="campo"><span>Repetir</span><input type="password" name="pin2" inputmode="numeric" minlength="4" maxlength="6" required /></label>
    </div>
    <button class="btn ancho">Cambiar PIN</button>
</form>
<form method="post" asp-page-handler="Importar" enctype="multipart/form-data" class="tarjeta">
    <h2 class="mb">Importar recetas (JSON)</h2>
    <p class="suave peq">Mismo formato que <code>Seed/recetas.json</code>. Las que ya existan por nombre se saltan.</p>
    <div class="fila"><input type="file" name="recetas" accept="application/json" required class="crece" /><button class="btn">Importar</button></div>
</form>
<div class="tarjeta">
    <h2 class="mb">Copia de seguridad</h2>
    <a class="btn ancho" href="/Admin/Config?handler=Backup">Descargar base de datos y adjuntos</a>
</div>

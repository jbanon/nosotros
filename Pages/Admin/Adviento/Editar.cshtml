@page "{dia:int}"
@model Love.Pages.Admin.Adviento.EditarModel
@{ var c = Model.Casilla; ViewData["Title"] = $"Casilla {c.Dia}"; }
<div class="cab"><a class="volver" href="/Admin/Adviento">‹</a><h1>Casilla @c.Dia</h1><a class="accion" href="/Adviento/Dia/@c.Dia?fecha=@(new DateOnly(c.Anio, 12, c.Dia).ToString("yyyy-MM-dd"))">Vista previa</a></div>
<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Casilla.Id" />
    <input type="hidden" asp-for="Casilla.FotoPath" />
    <div asp-validation-summary="All" class="error"></div>
    <label class="campo"><span>Título</span><input asp-for="Casilla.Titulo" /></label>
    <div class="cuadricula">
        <label class="campo"><span>Tipo</span>
            <select asp-for="Casilla.Tipo">
                @foreach (var t in Enum.GetValues<TipoCasilla>()) { <option value="@t" selected="@(t == c.Tipo)">@t</option> }
            </select></label>
        <label class="campo"><span>Letra que gana</span><input asp-for="Casilla.Letra" maxlength="1" autocapitalize="characters" placeholder="(ninguna)" /></label>
    </div>
    <label class="campo"><span>Texto tuyo · intro, pie de foto, dedicatoria del vale o carta final</span><textarea asp-for="Casilla.Intro" rows="5"></textarea></label>

    <div class="tarjeta">
        <h2 class="mb">Foto</h2>
        @if (c.FotoPath != null)
        {
            <p><img src="/Adviento/Foto/@c.Id" class="miniatura" style="width:120px;height:120px" alt="" /></p>
            <label class="chip"><input type="checkbox" asp-for="QuitarFoto" style="display:inline" /> Quitar la foto</label>
        }
        <label class="campo mt"><span>@(c.FotoPath != null ? "Sustituir foto" : "Subir foto")</span><input type="file" asp-for="Foto" accept="image/*" /></label>
        <p class="suave peq" style="margin-bottom:0">Las casillas de tipo Foto la muestran a lo grande. En cualquier otra casilla, la foto sale en el collage del día 24.</p>
    </div>

    <div class="tarjeta">
        <h2 class="mb">Vídeo</h2>
        <video id="video-actual" class="video-admin" controls playsinline preload="metadata" src="@(c.VideoPath != null ? $"/Adviento/Video/{c.Id}" : null)" hidden="@(c.VideoPath == null)"></video>
        <p class="error peq" id="video-error" hidden>Este navegador no sabe reproducir el vídeo; probablemente esté grabado en HEVC («vídeo de alta eficiencia»). Desactiva esa opción en la cámara y vuelve a grabarlo, o conviértelo a MP4.</p>
        @if (c.VideoPath != null) { <label class="chip"><input type="checkbox" asp-for="QuitarVideo" style="display:inline" /> Quitar el vídeo</label> }
        <label class="campo mt"><span id="video-etiqueta">@(c.VideoPath != null ? "Sustituir vídeo" : "Subir vídeo")</span><input type="file" id="video-fichero" accept="video/mp4,video/quicktime,video/webm,video/*" /></label>
        <div id="subida" hidden><div class="progreso"><i id="subida-barra" style="width:0"></i></div><p class="peq" id="subida-texto" style="margin:0 0 10px"></p></div>
        <p class="suave peq" style="margin-bottom:0">En una casilla de tipo Foto, el vídeo se ve a pantalla completa con adornos de Navidad, y la foto, si la hay, le sirve de portada. Se sube al elegirlo, por trozos: puede tardar unos minutos y no hay que cerrar la página. Máximo 1 GB; mejor grabado en 1080p que en 4K.</p>
    </div>

    <div class="tarjeta">
        <h2 class="mb">Reto de la foto (opcional)</h2>
        <label class="campo"><span>Pregunta</span><input asp-for="Casilla.Pregunta" placeholder="¿En qué país estábamos?" /></label>
        <label class="campo"><span>Respuesta (una palabra; da igual mayúsculas y tildes)</span><input asp-for="Casilla.Respuesta" placeholder="Gales" /></label>
        <p class="suave peq" style="margin-bottom:0">Con pregunta, la foto sale borrosa hasta que acierta y la letra se gana al acertar. Sin pregunta, la foto se ve directamente y la letra se gana al abrir.</p>
    </div>

    <label class="campo"><span>Viñeta de regalo al resolver (opcional)</span>
        <select asp-for="Casilla.VinetaId">
            <option value="">(ninguna)</option>
            @foreach (var v in Model.Vinetas) { <option value="@v.Id" selected="@(v.Id == c.VinetaId)">@(v.FraseAutor ?? v.Descripcion ?? $"#{v.Id}")@(string.IsNullOrWhiteSpace(v.FraseMia) ? "" : " ★")@(v.MostradaEl != null ? " (ya vista)" : "")</option> }
        </select></label>
    <details class="ticket">
        <summary>Datos del pasatiempo (JSON)</summary>
        <textarea asp-for="Casilla.Datos" rows="14" style="font-family:monospace;font-size:.8rem;margin-top:10px"></textarea>
        <p class="suave peq">Criptofrase: <code>frase</code>, <code>pista</code>. Murdoku: <code>caso</code>, <code>categorias</code>, <code>pistas</code>, <code>remate</code>, <code>solucion</code>, <code>explicacion</code>. Crucigrama: <code>palabras</code> (palabra, dir H/V, fila, col, pista) y <code>letra</code> (fila, col). Final: <code>vale</code>.</p>
    </details>

    <button class="btn primario ancho mt">Guardar</button>
</form>

<div class="tarjeta mt">
    <h2 class="mb">Seguimiento</h2>
    <p class="suave">Abierta: <b>@(c.AbiertaEl?.ToLocalTime().ToString("d MMM HH:mm") ?? "no")</b> · Resuelta: <b>@(c.ResueltaEl?.ToLocalTime().ToString("d MMM HH:mm") ?? "no")</b> · Pistas: <b>@c.Pistas</b>@if (c.Tipo == TipoCasilla.Vale) { <text> · Canjeado: <b>@(c.CanjeadoEl?.ToLocalTime().ToString("d MMM HH:mm") ?? "no")</b></text> }</p>
    <form method="post" asp-page-handler="Reiniciar" asp-route-dia="@c.Dia" data-confirm="¿Borrar el progreso de esta casilla?">
        <button class="btn peligro pequeno">Reiniciar esta casilla</button>
    </form>
</div>

@section Scripts {
<script>
// Subida del vídeo por trozos de 8 MB (el límite de nginx es 30 MB por petición); reintenta el trozo si se corta.
(() => {
  const inp = document.getElementById('video-fichero'), caja = document.getElementById('subida');
  const barra = document.getElementById('subida-barra'), txt = document.getElementById('subida-texto');
  const video = document.getElementById('video-actual'), errVideo = document.getElementById('video-error');
  const token = document.querySelector('input[name=__RequestVerificationToken]').value;
  const TROZO = 8 * 1024 * 1024, MAX = @Love.Pages.Admin.Adviento.EditarModel.MaxVideo;
  const mb = n => Math.round(n / 1048576).toLocaleString('es-ES') + ' MB';
  const espera = ms => new Promise(r => setTimeout(r, ms));
  let subiendo = false;
  video.addEventListener('error', () => { if (video.error?.code === 4) errVideo.hidden = false; });
  window.addEventListener('beforeunload', e => { if (subiendo) { e.preventDefault(); e.returnValue = ''; } });
  const pinta = (t, mal) => { txt.textContent = t; txt.className = 'peq' + (mal ? ' error' : ''); };
  inp.addEventListener('change', async () => {
    const f = inp.files[0]; if (!f) return;
    caja.hidden = false; barra.style.width = '0';
    if (f.size > MAX) { pinta('Pasa de 1 GB (' + mb(f.size) + '): grábalo en 1080p o recórtalo.', true); return; }
    const id = Array.from(crypto.getRandomValues(new Uint8Array(16)), b => b.toString(16).padStart(2, '0')).join('');
    subiendo = true; inp.disabled = true;
    let desde = 0, fallos = 0, listo = null;
    const t0 = Date.now();
    pinta('Subiendo ' + f.name + '…');
    while (!listo) {
      const fd = new FormData();
      fd.append('subida', id); fd.append('desde', desde); fd.append('total', f.size); fd.append('nombre', f.name);
      fd.append('trozo', f.slice(desde, desde + TROZO), 'trozo');
      let r = null, j = {};
      try { r = await fetch(location.pathname + '?handler=Trozo', { method: 'POST', headers: { RequestVerificationToken: token }, body: fd }); j = await r.json().catch(() => ({})); } catch { }
      if (r && (r.ok || r.status === 409) && j.recibido != null) { desde = j.recibido; fallos = 0; if (j.listo) listo = j; }
      else if (r && r.status === 400) { pinta(j.error || 'No se ha podido subir el vídeo.', true); break; }
      else if (++fallos > 6) { pinta('Se ha cortado la conexión. Vuelve a elegir el vídeo para reintentarlo.', true); break; }
      else { pinta('Se ha cortado la conexión, reintentando…'); await espera(1500 * fallos); continue; }
      const pct = desde / f.size * 100, seg = (Date.now() - t0) / 1000, quedan = desde ? seg * (f.size - desde) / desde : 0;
      barra.style.width = pct + '%';
      if (!listo) pinta(`Subiendo: ${mb(desde)} de ${mb(f.size)} (${Math.floor(pct)} %)` + (seg > 5 ? ` · faltan ~${Math.max(1, Math.round(quedan / 60))} min` : ''));
    }
    subiendo = false; inp.disabled = false; inp.value = '';
    if (listo) {
      pinta('✓ Vídeo subido y guardado en la casilla.');
      errVideo.hidden = true; video.hidden = false; video.src = listo.url;
      document.getElementById('video-etiqueta').textContent = 'Sustituir vídeo';
    }
  });
})();
</script>
}

@model System.Text.Json.Nodes.JsonArray
@if (Model.Count > 0)
{
    <div class="conversacion">
        @foreach (var m in Model)
        {
            var usuario = m?["rol"]?.GetValue<string>() == "usuario";
            <div class="burbuja @(usuario ? "usuario" : "agente")"><span class="quien">@(usuario ? "Tú" : "Agente ✨")</span>@m?["texto"]</div>
        }
    </div>
}

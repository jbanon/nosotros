@using System.Security.Claims
@inject IWebHostEnvironment WebEnv
@{
    var esAdmin = User.EsAdmin();
    var path = Context.Request.Path.Value ?? "";
    string act(string p) => path.StartsWith(p, StringComparison.OrdinalIgnoreCase) ? "activo" : "";
    var tema = ViewData["Tema"] as string;
    var sinNav = ViewData["SinNav"] as bool? ?? false;
    // Teaser del adviento: hasta el 1 de diciembre, 1 s cada 3 días, solo a Raquel (Javi lo ve con ?teaser=1)
    var hoyT = Love.Services.Reloj.Hoy;
    var teaser = User.Identity?.IsAuthenticated == true && !sinNav
        && hoyT < new DateOnly(hoyT.Year, 12, 1) && hoyT.Month >= 11
        && System.IO.File.Exists(System.IO.Path.Combine(WebEnv.WebRootPath, "img", "teaser.mp4"))
        && (!esAdmin || Context.Request.Query.ContainsKey("teaser"));
}
<!DOCTYPE html>
<html lang="es"@Html.Raw(tema != null ? $" data-tema=\"{tema}\"" : "")>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fbf6f0" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " · " : "")Nosotros</title>
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(sinNav ? "sin-nav" : "")">
    <main class="contenido">
        @RenderBody()
    </main>
    @if (!sinNav && User.Identity?.IsAuthenticated == true)
    {
        <nav class="barra">
            <a href="/Amor" class="@act("/Amor")"><span class="ico">♥</span><span>@(esAdmin ? "Raquel" : "Para ti")</span></a>
            <a href="/Menu/Recetas" class="@act("/Menu/Recetas")"><span class="ico">🍲</span><span>Recetas</span></a>
            <a href="/Menu/Lista" class="@(act("/Menu/Lista"))@(act("/Menu/Semana"))@(act("/Listas"))"><span class="ico">🛒</span><span>Compra</span></a>
            <a href="/Gastos" class="@act("/Gastos")"><span class="ico">€</span><span>Gastos</span></a>
            @if (!esAdmin)
            {
                <a href="/Ideas" class="@act("/Ideas")"><span class="ico">✨</span><span>Ideas</span></a>
                <a href="/Peliculas" class="@act("/Peliculas")"><span class="ico">🎬</span><span>Pelis</span></a>
            }
            else
            {
                <a href="/Admin" class="@act("/Admin")"><span class="ico">⚙</span><span>Admin</span></a>
            }
        </nav>
    }
    @if (teaser)
    {
        <div id="teaser" class="teaser" hidden data-forzar="@(esAdmin ? "1" : "")">
            <video muted playsinline autoplay preload="auto"></video>
            <p>Something's cooking…</p>
        </div>
        <script>
            (() => {
                const t = document.getElementById('teaser'), k = 'teaser-visto', cada = 3 * 864e5;
                let ultimo = 0;
                try { ultimo = +localStorage.getItem(k) || 0; } catch { }
                if (!t.dataset.forzar && Date.now() - ultimo < cada) return;
                const v = t.querySelector('video'), quitar = () => { t.classList.remove('dentro'); setTimeout(() => t.remove(), 400); };
                let hecho = false;
                // Visible pero transparente mientras carga (algunos móviles no reproducen vídeos ocultos)
                t.hidden = false;
                v.addEventListener('playing', () => {
                    if (hecho) return; hecho = true;
                    try { localStorage.setItem(k, Date.now()); } catch { }
                    t.classList.add('dentro');
                    setTimeout(quitar, 1000);
                });
                setTimeout(() => { if (!hecho) t.remove(); }, 5000);
                v.src = '/img/teaser.mp4';
                v.play().catch(() => t.remove());
            })();
        </script>
    }
    <script src="/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@page
@model Love.Pages.Amor.IndexModel
@{
    ViewData["Title"] = "Para " + Model.Nombre;
    var t = Model.Msg.Tema;
    var versos = Model.Msg.Texto.Split('\n');
}
@section Head {
    <meta name="theme-color" content="var(--fondo-1)" />
}
<div class="amor" data-particulas="@t.Particulas">
    <div class="cielo"></div>
    <div class="particulas" id="particulas"></div>

    <header class="amor-cab">
        <p class="saludo">@Model.Saludo, @Model.Nombre</p>
        <p class="fecha">@Model.Fecha.ToString("dddd d 'de' MMMM")</p>
    </header>

    <article class="tarjeta-amor @(Model.Msg.Tipo == TipoMensaje.Poema ? "poema" : "frase") @(Model.Msg.Especial != null ? "especial" : "")">
        @if (Model.Msg.Especial != null)
        {
            <div class="especial-cab">
                <span class="emoji">@Model.Msg.Especial.Emoji</span>
                <span class="nombre">@Model.Msg.Especial.Nombre</span>
                @if (Model.Msg.Contador != null) { <span class="contador">@Model.Msg.Contador</span> }
            </div>
        }
        else if (Model.Msg.Titulo != null)
        {
            <p class="titulo">@Model.Msg.Titulo</p>
        }
        <div class="texto">
            @foreach (var v in versos) { <p>@v</p> }
        </div>
        <p class="firma">— @Model.Firma</p>
    </article>

    @if (!string.IsNullOrWhiteSpace(Model.Declaracion))
    {
        <section class="declaracion" aria-label="Declaración">
            <span class="orn">❧</span>
            @foreach (var v in Model.Declaracion.Replace("\r", "").Split('\n', StringSplitOptions.RemoveEmptyEntries)) { <p>@v</p> }
        </section>
    }

    @if (Model.Vineta != null && Model.Vineta.Desvelada)
    {
        var vd = Model.Vineta;
        <a class="vineta-dia" href="/Vinetas/Ver/@vd.VinetaId">
            <img src="/Vinetas/Imagen/@vd.VinetaId" alt="" />
            @if (!string.IsNullOrWhiteSpace(vd.Vineta.FraseMia)) { <p class="vineta-frase">@vd.Vineta.FraseMia</p> }
            <span class="vineta-pie">ver en el álbum ›</span>
        </a>
    }
    else if (Model.Vineta != null)
    {
        <a class="lectura-aviso" href="/Vinetas/Hoy">
            <span class="ico">🧩</span>
            <span class="crece"><b>Hoy la viñeta se gana</b><br /><span>@IndexModel.NombreJuego(Model.Vineta.Juego) · toca para jugar@(Model.JuegosPendientes > 0 ? $" · y {Model.JuegosPendientes} más por jugar" : "")</span></span>
            <span class="flecha">›</span>
        </a>
    }
    @if ((Model.Vineta == null || Model.Vineta.Desvelada) && Model.JuegosPendientes > 0)
    {
        <a class="lectura-aviso" href="/Vinetas">
            <span class="ico">🧩</span>
            <span class="crece"><b>@(Model.JuegosPendientes == 1 ? "Tienes un juego por jugar" : $"Tienes {Model.JuegosPendientes} juegos por jugar")</b><br /><span>de días en que no entraste · siguen ahí</span></span>
            <span class="flecha">›</span>
        </a>
    }

    @if (Model.ObraSemana != null)
    {
        <a class="lectura-aviso" href="/Arte/Ver/@Model.ObraSemana.Id">
            <span class="ico">🎨</span>
            <span class="crece"><b>Esta semana: @Model.ObraSemana.Titulo</b><br /><span>@Model.ObraSemana.Autor · @Model.ObraSemana.Paradas.Count detalles para mirar despacio</span></span>
            <span class="flecha">›</span>
        </a>
    }
    @if (Model.CapituloSemana != null)
    {
        <a class="lectura-aviso" href="/Arte/Capitulo/@Model.CapituloSemana.Id">
            <span class="ico">🎨</span>
            <span class="crece"><b>Esta semana, un capítulo: @Model.CapituloSemana.Artista</b><br /><span>Su vida, su manera de mirar y @(Model.CapituloSemana.Obras.Count > 0 ? $"{Model.CapituloSemana.Obras.Count} obras para entrar despacio" : "sus obras, para entrar despacio")</span></span>
            <span class="flecha">›</span>
        </a>
    }

    @if (Model.Adviento != null)
    {
        if (Model.AdvientoEnlace)
        {
            <a class="lectura-aviso adviento-aviso" href="/Adviento@(Model.Preview ? $"?fecha={Model.Fecha:yyyy-MM-dd}" : "")">
                <span class="ico">🎄</span>
                <span class="crece"><b>@Model.Adviento</b><br /><span>@Model.AdvientoSub</span></span>
                <span class="flecha">›</span>
            </a>
        }
        else
        {
            <div class="lectura-aviso adviento-aviso"><span class="ico">🎄</span><span class="crece"><b>@Model.Adviento</b><br /><span>@Model.AdvientoSub</span></span></div>
        }
    }

    @if (Model.LecturaNueva != null)
    {
        <a class="lectura-aviso" href="/Lecturas/Leer/@Model.LecturaNueva.Id">
            <span class="ico">📖</span>
            <span class="crece"><b>Te he dejado una lectura</b><br /><span>«@Model.LecturaNueva.Titulo»@(Model.LecturaNueva.Autor != null ? $", de {Model.LecturaNueva.Autor}" : "") · @Model.LecturaNueva.Minutos min</span></span>
            <span class="flecha">›</span>
        </a>
    }
    else if (Model.NumLecturas > 0 || Model.VinetasDescubiertas > 0 || Model.ObrasPublicadas > 0)
    {
        var enlaces = new List<(string url, string txt)>();
        if (Model.NumLecturas > 0) enlaces.Add(("/Lecturas", "📖 Lecturas"));
        if (Model.VinetasDescubiertas > 0) enlaces.Add(("/Vinetas", "💌 Álbum"));
        if (Model.ObrasPublicadas > 0) enlaces.Add(("/Arte", "🎨 Arte"));
        <p class="lectura-enlace">@for (int i = 0; i < enlaces.Count; i++) { if (i > 0) { <text> · </text> } <a href="@enlaces[i].url">@enlaces[i].txt</a> }</p>
    }

    <footer class="amor-pie">
        <button class="corazon" id="corazon" type="button" aria-label="Corazón">♥</button>
        @if (Model.DiasJuntos > 0) { <p class="dias"><b>@Model.DiasJuntos.ToString("N0")</b> días juntos</p> }
        @if (Model.Proximo != null)
        {
            <p class="proximo">@Model.Proximo.Fecha.Emoji @(Model.Proximo.DiasFaltan == 1 ? "Mañana es" : $"Faltan {Model.Proximo.DiasFaltan} días para") @Model.Proximo.Fecha.Nombre.ToLowerInvariant()</p>
        }
    </footer>

    @if (Model.Preview)
    {
        <div class="preview-aviso">Vista previa del @Model.Fecha.ToString("d/M/yyyy") · tema @t.Nombre</div>
    }
</div>

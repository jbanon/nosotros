@page
@model Love.Pages.Menu.ListaModel
@{
    ViewData["Title"] = "Lista de la compra";
    var l = Model.Lunes.ToString("yyyy-MM-dd");
    var incluidos = Model.Semana.Lista.Where(i => i.Incluido).ToList();
    var excluidos = Model.Semana.Lista.Where(i => !i.Incluido).OrderBy(i => i.Nombre).ToList();
    var pendientes = incluidos.Count(i => !i.Comprado);
}
<partial name="_PestanasCompra" model="@("compra")" />
<div class="cab">
    <h1>La compra</h1>
    <button type="button" class="btn pequeno" data-share="texto-lista">Compartir ⤴</button>
</div>
<div class="segmento">
    <a href="?lunes=@Model.Lunes.AddDays(-7).ToString("yyyy-MM-dd")">‹</a>
    <div class="titulo">@Model.Lunes.ToString("d MMM") – @Model.Lunes.AddDays(6).ToString("d MMM")</div>
    <a href="?lunes=@Model.Lunes.AddDays(7).ToString("yyyy-MM-dd")">›</a>
</div>
<p class="suave peq fila" style="margin-top:-6px">
    <span class="crece">@Model.Semana.Recetas.Count recetas · @pendientes por comprar · para @Model.Raciones raciones</span>
    <a href="/Menu/Semana?lunes=@l">Cambiar recetas →</a>
</p>
@if (Model.Comprando)
{
    <div class="crono fila">
        <span class="punto-rojo"></span>
        <span class="crece">Comprando · <b id="crono" data-inicio="@Model.Semana.CompraInicio!.Value.ToString("o")Z">@Model.MinutosComprando min</b> <span class="suave peq" style="font-weight:600">· desde el primer producto marcado</span></span>
        <form method="post" asp-page-handler="Empezar" asp-route-lunes="@l" asp-route-parar="true" data-confirm="¿Parar el cronómetro? Volverá a arrancar al marcar otro producto."><button class="btn pequeno fantasma">Cancelar</button></form>
    </div>
}
@if (!incluidos.Any())
{
    <div class="vacio"><span class="ico">🛒</span>La lista está vacía.<br /><a href="/Menu/Semana?lunes=@l">Marca recetas para la semana</a> o añade algo abajo.</div>
}
@foreach (var g in incluidos.GroupBy(i => i.Zona).OrderBy(g => g.Key))
{
    <section class="bloque-zona z-@ZonaInfo.Css(g.Key)">
        <div class="zona-cab">@ZonaInfo.Emoji(g.Key) @ZonaInfo.Nombre(g.Key) <span class="suave" style="font-weight:600;letter-spacing:0;text-transform:none">· @g.Count(i => !i.Comprado)</span></div>
        @foreach (var it in g.OrderBy(i => i.Comprado).ThenBy(i => i.Nombre))
        {
            <div class="linea-compra @(it.Comprado ? "comprado" : "")">
                <form method="post" asp-page-handler="Comprado" asp-route-lunes="@l" asp-route-id="@it.Id" class="crece fila" style="gap:10px">
                    <button class="check" style="cursor:pointer">@(it.Comprado ? "✓" : "")</button>
                    <button style="background:none;border:0;padding:0;text-align:left;font:inherit;color:inherit;flex:1">
                        <div class="nombre">@it.Nombre @if (it.Manual) { <span class="suave peq">· extra</span> }</div>
                        @if (!string.IsNullOrEmpty(it.Origen)) { <div class="para">para @it.Origen</div> }
                    </button>
                    <span class="cant">@ListaCompraService.Cant(it)</span>
                </form>
                <form method="post" asp-page-handler="Incluir" asp-route-lunes="@l" asp-route-id="@it.Id" asp-route-incluir="false">
                    <button class="quitar" title="@(it.Manual ? "Quitar" : "No comprar esta vez")">×</button>
                </form>
            </div>
        }
    </section>
}

@if (Model.Reponer.Any())
{
    <div class="tarjeta">
        <h2 class="mb">Quizá toca reponer <span class="suave peq" style="font-weight:600">(según los tickets · toca para añadir)</span></h2>
        <div class="chips">
            @foreach (var p in Model.Reponer)
            {
                <form method="post" asp-page-handler="Anadir" asp-route-lunes="@l">
                    <input type="hidden" name="nombre" value="@p.Nombre" /><input type="hidden" name="zona" value="Otros" />
                    <button class="chip">+ @p.Nombre <span class="suave peq">· cada ~@p.CadaDias días</span></button>
                </form>
            }
        </div>
    </div>
}

<div class="tarjeta">
    <h2 class="mb">Añadir algo más</h2>
    <form method="post" asp-page-handler="Anadir" asp-route-lunes="@l">
        <div class="fila mb">
            <input type="text" name="nombre" placeholder="Papel de cocina" required class="crece" />
            <input type="text" name="cantidad" placeholder="2 ud" style="width:90px" />
        </div>
        <div class="fila">
            <select name="zona" class="crece">@foreach (var z in ZonaInfo.Todas) { <option value="@z" selected="@(z == Zona.Otros)">@ZonaInfo.Emoji(z) @ZonaInfo.Nombre(z)</option> }</select>
            <button class="btn primario">Añadir</button>
        </div>
    </form>
</div>

@if (excluidos.Any())
{
    <div class="tarjeta">
        <h2 class="mb">No se compra esta vez <span class="suave peq" style="font-weight:600">(sal, aceite… toca para incluir)</span></h2>
        <div class="chips">
            @foreach (var it in excluidos)
            {
                <form method="post" asp-page-handler="Incluir" asp-route-lunes="@l" asp-route-id="@it.Id" asp-route-incluir="true">
                    <button class="chip">+ @it.Nombre</button>
                </form>
            }
        </div>
    </div>
}
@if (incluidos.Any(i => i.Comprado))
{
    var comprados = incluidos.Count(i => i.Comprado);
    <div class="tarjeta cierre-compra @(pendientes == 0 ? "completa" : "")">
        <h2 class="mb">🧾 @(pendientes == 0 ? "¡Compra terminada!" : "¿Has terminado la compra?")</h2>
        <p class="suave peq" style="margin-top:0">Apunta el ticket en Gastos: se suma a la compra del mes y guarda el detalle de lo comprado (@comprados producto@(comprados == 1 ? "" : "s"))@if (Model.Comprando) { <text> y el tiempo que has tardado (<b>@Model.MinutosComprando min</b>)</text> }.</p>
        @if (Model.ComprasHoy.Any()) { <p class="aviso mb">Hoy ya hay apuntada@(Model.ComprasHoy.Count == 1 ? "" : "s") @Model.ComprasHoy.Count compra@(Model.ComprasHoy.Count == 1 ? "" : "s") (@Model.ComprasHoy.Sum(g => g.Importe).ToString("N2") €). Si es la misma, no la repitas.</p> }
        @if (Model.ErrorGasto != null) { <p class="error">@Model.ErrorGasto</p> }
        <form method="post" asp-page-handler="ApuntarGasto" asp-route-lunes="@l" enctype="multipart/form-data">
            <div class="fila mb">
                <input type="text" name="importe" inputmode="decimal" placeholder="Importe del ticket (€)" class="crece" autocomplete="off" style="font-size:1.3rem;font-weight:800" required />
            </div>
            <label class="campo"><span>Foto del ticket (opcional)</span><input type="file" name="ticket" accept="image/*" capture="environment" /></label>
            <label class="chip mb"><input type="checkbox" name="desmarcar" value="true" style="display:inline" /> Desmarcar lo comprado al apuntar</label>
            <button class="btn primario ancho">Apuntar la compra en Gastos</button>
        </form>
        <p class="suave peq centrado" style="margin:10px 0 0"><a href="/Gastos/Editar?lunes=@l">Con más detalle (precio por producto) →</a></p>
    </div>
    <form method="post" asp-page-handler="Limpiar" asp-route-lunes="@l" data-confirm="¿Desmarcar lo comprado?"><button class="btn ancho">Desmarcar lo comprado</button></form>
}
<pre id="texto-lista" hidden>@Model.TextoCompartir</pre>
@if (Model.Comprando)
{
    @section Scripts {
    <script>(() => { const c = document.getElementById('crono'); if (!c) return; const ini = new Date(c.dataset.inicio.replace(/Z+$/, 'Z'));
      const pinta = () => { const m = Math.max(0, Math.round((Date.now() - ini) / 60000)); c.textContent = m < 60 ? m + ' min' : Math.floor(m / 60) + ' h ' + (m % 60) + ' min'; };
      pinta(); setInterval(pinta, 15000); })();</script>
    }
}

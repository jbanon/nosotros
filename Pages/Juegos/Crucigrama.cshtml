@page
@model Love.Pages.Juegos.CrucigramaModel
@{
    ViewData["Title"] = "Crucigrama";
    var r = Model.Rejilla;
    var datos = new
    {
        semilla = Model.Semilla,
        filas = r.Filas,
        cols = r.Cols,
        defs = r.Defs.Select(d => new { num = d.Num, dir = d.Dir, fila = d.Fila, col = d.Col, largo = d.Largo, pista = d.Pista, sol = d.Palabra }),
    };
}
@Html.AntiForgeryToken()
<div class="cab cr-cab"><a class="volver" href="/Juegos">‹</a><h1>@(Model.N == 0 ? "Crucigrama del día" : $"Crucigrama extra nº {Model.N}")</h1></div>
<p class="suave peq cr-sub">@Reloj.Hoy.ToString("dddd d 'de' MMMM") · @r.Defs.Count palabras · a medias · <span id="cr-progreso"></span> <span class="cr-otro" id="cr-otro" hidden></span></p>
<div class="cr-pista" id="cr-pista" aria-live="polite">
    <button type="button" id="cr-ant" aria-label="Definición anterior">‹</button>
    <div class="cr-pista-txt" id="cr-pista-txt">Toca una casilla para empezar</div>
    <button type="button" id="cr-sig" aria-label="Definición siguiente">›</button>
</div>
<div class="cr-rejilla" id="cr-rejilla" style="--cols:@r.Cols;--filas:@r.Filas"></div>
<div class="cr-botones">
    <button type="button" class="btn pequeno" id="cr-letra">💡 Una letra</button>
    <button type="button" class="btn pequeno" id="cr-comprobar">✓ Comprobar</button>
    <button type="button" class="btn pequeno fantasma" id="cr-rendirse">Ver solución</button>
</div>
<div class="cr-hecho" id="cr-hecho" hidden>
    <div class="cr-hecho-ico">🎉</div>
    <h2>¡Resuelto!</h2>
    <p id="cr-hecho-txt"></p>
    <a class="btn primario ancho" href="/Juegos/Crucigrama?n=@(Model.N + 1)">Otro crucigrama</a>
</div>
<div class="cr-defs" id="cr-defs"></div>
<p class="centrado peq mt">@if (Model.N > 0) { <a href="/Juegos/Crucigrama">El del día</a><text> · </text> }<a href="/Juegos/Crucigrama?n=@(Model.N + 1)">Otro distinto →</a></p>
<script type="application/json" id="cr-datos">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(datos).Replace("</", "<\\/"))</script>
@section Scripts { <script src="/js/crucigrama.js" asp-append-version="true"></script> }

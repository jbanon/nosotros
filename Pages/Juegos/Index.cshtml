@page
@inject Love.Services.DueloCifras Duelo
@inject Love.Services.JuegosDiarios Diarios
@inject Love.Services.LineaArte Linea
@{
    ViewData["Title"] = "Juegos";
    var yo = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
    var reto = Duelo.RetoPara(yo);
    var lineaMia = await Linea.DeSemana(yo, LineaArte.Lunes(Reloj.Hoy));
    var lineaJugada = lineaMia?.Fin != null && !User.EsAdmin();
    var diarios = new List<(JuegosDiarios.Juego j, DateOnly? bloq, Love.Models.JuegoPartida? hoy)>();
    foreach (var j in JuegosDiarios.Todos)
    {
        var bloq = User.EsAdmin() ? null : await Diarios.BloqueadoHasta(j, Reloj.Hoy);
        if (bloq == DateOnly.MaxValue) continue;   // juego aún sin hacer
        diarios.Add((j, bloq, await Diarios.DeHoy(yo, j, Reloj.Hoy)));
    }
}
<div class="cab"><h1>Juegos</h1>@if (User.EsAdmin()) { <a class="accion" href="/Juegos/Frases">✏️ Frases</a> }</div>
<p class="suave peq" style="margin-top:0">Un ratito para pensar. Sin prisas… salvo en Cifras.</p>
<a class="jg-tarjeta jg-cifras" href="/Juegos/Cifras">
    <div class="jg-vista" aria-hidden="true">
        <div class="cf-marcador mini"><span>7</span><span>4</span><span>2</span></div>
        <div class="jg-fichas"><i>75</i><i>8</i><i>3</i></div>
    </div>
    <div class="jg-texto">
        <h2>Cifras</h2>
        <p>Seis números, un objetivo y 45 segundos. Suma, resta, multiplica y divide hasta clavarlo.</p>
        <p class="jg-stats" data-stats="cifras"></p>
    </div>
</a>
<a class="jg-tarjeta jg-duelo" href="/Juegos/Duelo">
    <div class="jg-vista" aria-hidden="true">⚔️</div>
    <div class="jg-texto">
        <h2>Duelo de Cifras @if (reto != null) { <span class="jg-badge">¡reto!</span> }</h2>
        <p>@(reto != null ? $"{reto} te ha retado. Mismos números, a la vez: ¿quién se acerca más?" : "Los dos a la vez con los mismos números. Gana quien más se acerque.")</p>
    </div>
</a>
<a class="jg-tarjeta jg-cruci" href="/Juegos/Crucigrama">
    <div class="jg-vista" aria-hidden="true">
        <div class="jg-mini-cruci">
            @foreach (var c in "·A··|AMOR|·O··|·R··".Split('|'))
            {
                foreach (var ch in c) { if (ch == '·') { <i class="h"></i> } else { <i>@ch</i> } }
            }
        </div>
    </div>
    <div class="jg-texto">
        <h2>Crucigrama del día</h2>
        <p>Uno nuevo cada día, compartido: lo que escribe uno le sale al otro al momento. Con definiciones con guasa.</p>
        <p class="jg-stats" data-stats="cruci"></p>
    </div>
</a>
<h2 class="jg-seccion">Una partida a la semana <span class="suave peq" style="font-weight:600">· obras nuevas cada lunes</span></h2>
<a class="jg-tarjeta jg-diario @(lineaJugada ? "jugada" : "")" href="/Juegos/Linea">
    <div class="jg-vista" aria-hidden="true"><img src="/img/briska-pintora.png" alt="" style="width:64px" /></div>
    <div class="jg-texto">
        <h2>Línea del tiempo @if (!lineaJugada) { <span class="jg-badge">esta semana</span> }</h2>
        <p>BriskaBird, con boina de pintora, te enseña cinco cuadros famosos: ordénalos en el tiempo y adivina quién los pintó.</p>
        @if (lineaJugada) { <p class="jg-stats">Esta semana: @lineaMia!.Palabras de @LineaArte.Maximo puntos · el lunes, más</p> }
    </div>
</a>
@if (diarios.Count > 0)
{
    <h2 class="jg-seccion">Una partida al día <span class="suave peq" style="font-weight:600">· con Briska y una frase nueva cada día</span></h2>
    foreach (var (j, bloq, hoy) in diarios)
    {
        var jugada = hoy != null && !User.EsAdmin();
        <a class="jg-tarjeta jg-diario @(bloq != null ? "bloqueado" : "") @(jugada ? "jugada" : "")" href="@(bloq != null ? "#" : $"/Juegos/Partida/{j.Clave}")">
            <div class="jg-vista" aria-hidden="true">@(bloq != null ? "🔒" : j.Emoji)</div>
            <div class="jg-texto">
                <h2>@j.Nombre @if (bloq == null && !jugada) { <span class="jg-badge">hoy</span> }</h2>
                <p>@(bloq != null ? $"Llega con el calendario de adviento: se desbloquea el {bloq.Value:d 'de' MMMM}." : j.Descripcion)</p>
                @if (jugada) { <p class="jg-stats">@(hoy!.Gano ? "Hoy: ¡frase acertada! 🏆" : hoy.Fin != null ? $"Hoy: {hoy.Palabras} de {hoy.Total} palabras" : "Hoy ya has jugado") · mañana, otra</p> }
            </div>
        </a>
    }
}
@section Scripts {
<script>
(() => {
  const lee = k => { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch { return null; } };
  const cf = lee('cifras-stats');
  const el1 = document.querySelector('[data-stats="cifras"]');
  if (cf && cf.jugadas) el1.textContent = `${cf.exactas} exactas de ${cf.jugadas}` + (cf.racha > 1 ? ` · racha de ${cf.racha} 🔥` : '');
  const cr = lee('cruci-stats');
  const el2 = document.querySelector('[data-stats="cruci"]');
  if (cr && cr.hechos) el2.textContent = `${cr.hechos} resuelto${cr.hechos === 1 ? '' : 's'}`;
})();
</script>
}

# /etc/love.env  (root, 600). Lo carga love.service con EnvironmentFile=.
# Base de datos PostgreSQL (la crea deploy/instalar-postgres.sh con contraseña aleatoria).
ConnectionStrings__Love=Host=localhost;Database=love;Username=love;Password=...
# PIN iniciales: solo se usan al crear la base de datos.
Pins__Admin=000000
Pins__Raquel=0000
# Agente claude -p (ver deploy/instalar-claude.sh). Siempre con la suscripción (token de `claude setup-token`),
# nunca ANTHROPIC_API_KEY.
Agente__Claude=/home/dev/.local/bin/claude
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
DISABLE_AUTOUPDATER=1
